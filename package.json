{
    "name": "excel-vba-sync",
    "displayName": "excel-vba-sync",
    "description": "Export VBA modules to VSCode & import them back to Excel.",
    "version": "0.0.81",
    "publisher": "9kv8xiyi",
    "license": "MIT",
    "author": {
        "name": "Eitaro Seta",
        "email": "seta.eitaro@gmail.com",
        "url": "https://github.com/EitaroSeta"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/EitaroSeta/excel-vba-sync.git"
    },
    "keywords": [
        "excel",
        "xlsm",
        "csv",
        "automation",
        "office",
        "vba",
        "vscode",
        "spreadsheet"
    ],
    "categories": [
        "Programming Languages",
        "Debuggers",
        "Formatters",
        "Visualization",
        "Testing",
        "Data Science",
        "Other"
    ],
    "icon": "media/icon.png",
    "engines": {
        "vscode": "^1.102.0"
    },
    "activationEvents": [
        "onLanguage:vb"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "mcpServerDefinitionProviders": [
            {
                "id": "excel-vba-sync.mcpServers",
                "label": "Excel VBA Sync"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "excelVbaSync",
                    "title": "Excel VBA VSCode Sync",
                    "icon": "media/vscode_activity_icon_vbvs.svg"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Excel VBA Sync Configuration",
            "properties": {
                "excelVbaSync.exportFolder": {
                    "type": "string",
                    "default": "exported",
                    "description": "VBAモジュールのエクスポート先フォルダ"
                },
                "excelVbaSync.importPromptOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "エクスポートフォルダ配下の .bas/.cls/.frm を保存したとき、Excelへのインポートを提案する通知を表示する / Show a prompt offering to import into Excel when a .bas/.cls/.frm under the export folder is saved"
                },
                "excelVbaSync.mcpSyncMode": {
                    "type": "string",
                    "enum": ["manual", "remind", "auto"],
                    "default": "remind",
                    "enumDescriptions": [
                        "同期しない（AIエージェントの判断に任せる） / No sync; left to the AI agent's judgment",
                        "書き込み成功の応答に「このモジュールをエクスポートせよ」の指示を含める / Include an export reminder (with the export folder path) in each successful write response",
                        "書き込み成功後にサーバーが自動でそのモジュールをエクスポートする / The server automatically exports the module after each successful write"
                    ],
                    "description": "MCP経由の書き込み後、エクスポートフォルダのファイルをどう同期するか。remind/autoは対象ブックのエクスポートフォルダ（<エクスポート先>\\<ブック名>\\）が既に存在するときだけ動作する＝エクスポート運用をしていないブックには何もしない。Claude Code/Desktop等の手動設定クライアントは、変更後に「Print MCP Server Config」の再生成が必要 / How MCP writes sync to exported files. remind/auto act only when the workbook's export folder already exists, so they never touch workbooks you don't export. Manually-configured clients (Claude Code/Desktop) need the MCP config regenerated after changing this"
                }
            }
        },
        "views": {
            "excelVbaSync": [
                {
                    "id": "exportPanel",
                    "name": "v.0.0.28",
                    "icon": "media/icon.png"
                }
            ],
            "explorer": [
                {
                    "id": "excelVbaSyncView",
                    "name": "VBA Sync",
                    "icon": "media/icon.png"
                }
            ]
        },
        "commands": [
            {
                "command": "excel-vba-sync.exportVBA",
                "title": "Export All Modules From VBA",
                "icon": "$(cloud-download)"
            },
            {
                "command": "excel-vba-sync.importVBA",
                "title": "Import Module To VBA",
                "icon": "$(cloud-upload)"
            },
            {
                "command": "excel-vba-sync.setExportFolder",
                "title": "Set Export Folder",
                "icon": "$(folder)"
            },
            {
                "command": "excel-vba-sync.exportModuleByName",
                "title": "Export Module By Name"
            },
            {
                "command": "excel-vba-sync.generateFlowChart",
                "title": "Generate VBA Flow Chart",
                "icon": "$(graph)"
            },
            {
                "command": "vbaMcp.start",
                "title": "Excel VBA: Start Server"
            },
            {
                "command": "vbaMcp.stop",
                "title": "Excel VBA: Stop Server"
            },
            {
                "command": "vbaMcp.searchCode",
                "title": "Excel VBA: Search Code"
            },
            {
                "command": "vbaMcp.listAndRunMacro",
                "title": "Excel VBA: List & Run Macro"
            },
            {
                "command": "excel-vba-sync.printMcpConfig",
                "title": "Excel VBA: Print MCP Server Config (for AI)"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "excel-vba-sync.generateFlowChart",
                    "when": "explorerResourceIsFile && resourceExtname =~ /\\.(bas|cls|frm)$/",
                    "group": "vbatools@1"
                }
            ],
            "editor/context": [
                {
                    "command": "excel-vba-sync.generateFlowChart",
                    "when": "editorFocus && resourceExtname =~ /\\.(bas|cls|frm)$/",
                    "group": "vbatools@1"
                }
            ],
            "commandPalette": [
                {
                    "command": "excel-vba-sync.generateFlowChart",
                    "when": "true"
                }
            ],
            "view/title": [
                {
                    "command": "excel-vba-sync.exportVBA",
                    "when": "view == exportPanel",
                    "group": "navigation"
                },
                {
                    "command": "excel-vba-sync.importVBA",
                    "when": "view == exportPanel",
                    "group": "navigation"
                },
                {
                    "command": "excel-vba-sync.setExportFolder",
                    "when": "view == exportPanel",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "excel-vba-sync.importVBA",
                    "when": "viewItem == importableFile",
                    "group": "navigation"
                },
                {
                    "command": "excel-vba-sync.exportModuleByName",
                    "when": "viewItem == importableFile",
                    "group": "navigation"
                },
                {
                    "command": "excel-vba-sync.generateFlowChart",
                    "when": "viewItem == importableFile",
                    "group": "vbatools"
                }
            ]
        },
        "keybindings": [
        ],
        "languages": [
            {
                "id": "vb",
                "aliases": [
                    "Visual Basic",
                    "vb"
                ],
                "extensions": [
                    ".frm",
                    ".cls"
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "npm run compile && npm run build:server",
        "compile": "tsc -p ./",
        "build:server": "tsc -p src/server",
        "test:unit": "npm run build:server && node --test \"src/server/__tests__/*.test.js\"",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "20.x",
        "@types/vscode": "^1.102.0",
        "@typescript-eslint/eslint-plugin": "^8.31.1",
        "@typescript-eslint/parser": "^8.31.1",
        "@vscode/test-cli": "^0.0.11",
        "@vscode/test-electron": "^2.5.2",
        "eslint": "^9.25.1",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.17.5",
        "iconv-lite": "^0.6.3",
        "zod": "^3.25.76"
    }
}
